{
  "name": "watch-audio-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets your own AI agent read the transcripts on your watch-audio phone over the local network (paired, mutual TLS, read-only)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "watch-audio-mcp": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "lint": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "test:e2e": "tsc -p . && node --test --test-concurrency=1 dist/e2e/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "multicast-dns": "7.2.5",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
