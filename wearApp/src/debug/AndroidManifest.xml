<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug builds only: plays an audio file into the recorder instead of the microphone
            (docs/impl/wearos.md). Exported so `adb shell am start -n` can launch it; the action
            lets the main screen show its button without referencing debug classes.
        -->
        <activity
            android:name=".debug.DebugAudioInputActivity"
            android:exported="true"
            android:label="@string/debug_input_label"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="app.watchaudio.wear.debug.AUDIO_INPUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
