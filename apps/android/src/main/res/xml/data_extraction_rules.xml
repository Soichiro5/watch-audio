<?xml version="1.0" encoding="utf-8"?>
<!--
    Recordings and transcripts never go to cloud backup. Device-to-device transfer (cable or
    local Wi-Fi when setting up a new phone) is local and stays allowed so history can move.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
